# systemd 单元示例（不用 Docker 时）：
#   sudo cp deploy/animalcards.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now animalcards
[Unit]
Description=AnimalCards Globe (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/AnimalCards/webapp/backend
EnvironmentFile=-/opt/AnimalCards/webapp/.env
Environment=ANIMALCARDS_ROOT=/opt/AnimalCards
ExecStart=/opt/AnimalCards/webapp/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/AnimalCards
PrivateTmp=true

[Install]
WantedBy=multi-user.target
